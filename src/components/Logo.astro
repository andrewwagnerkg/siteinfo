---
/**
 * Neutral placeholder mark (same as public/favicon.svg). Decorative: the
 * company name is always rendered next to it as text.
 * Replace with the real logo when the brand book is ready.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 32 32"
  width="28"
  height="28"
  class:list={['shrink-0', className]}
>
  <rect width="32" height="32" rx="8" class="fill-primary"></rect>
  <path
    d="M10 11l5 5-5 5M17.5 21H23"
    fill="none"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="stroke-on-primary"></path>
</svg>
