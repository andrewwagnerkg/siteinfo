---
/**
 * Custom pages from src/content/pages/<lang>/<slug>.md, served at /{lang}{slug}/.
 * Add or remove a page by adding or removing the Markdown file in every language.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import { entryStaticPaths } from '../../lib/content';
import { RESERVED_SLUGS } from '../../lib/nav';

export async function getStaticPaths() {
  const paths = await entryStaticPaths('pages');
  for (const { params } of paths) {
    if (RESERVED_SLUGS.includes(params.slug) || params.slug.includes('/')) {
      throw new Error(`Custom page slug "${params.slug}" is reserved or nested. Rename src/content/pages/*/${params.slug}.md`);
    }
  }
  return paths;
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]['props'];

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description}>
  <PageHeader title={entry.data.title} />
  <Container class="pb-section">
    <Prose>
      <Content />
    </Prose>
  </Container>
</BaseLayout>
