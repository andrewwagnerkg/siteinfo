---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSection from '../../components/CtaSection.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import { langFromParam, langStaticPaths, useTranslations } from '../../i18n';
import { byOrder, getLocalized } from '../../lib/content';

export const getStaticPaths = langStaticPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const team = (await getLocalized('team', lang)).sort(byOrder);
---

<BaseLayout lang={lang} title={t.about.title} description={t.about.description}>
  <PageHeader title={t.about.title} lead={t.about.lead} />
  {
    team.length > 0 && (
      <Section id="team" title={t.about.teamTitle}>
        <ul role="list" class="grid gap-grid sm:grid-cols-2 lg:grid-cols-4">
          {team.map((member) => (
            <li class="min-w-0">
              {member.data.photo && (
                <Image
                  src={member.data.photo}
                  alt={member.data.photo_alt ?? member.data.name}
                  widths={[240, 480]}
                  sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 90vw"
                  class="mb-4 aspect-square w-full rounded-card bg-surface object-cover"
                />
              )}
              <h3 class="text-h3 font-semibold">{member.data.name}</h3>
              <p class="mt-1 text-muted">{member.data.role}</p>
              {member.data.links.length > 0 && (
                <ul role="list" class="mt-2 flex flex-wrap gap-x-4">
                  {member.data.links.map((link) => (
                    <li class="min-w-0">
                      <a href={link.url} rel="noopener" class="link inline-flex min-h-touch items-center">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </Section>
    )
  }
  <CtaSection lang={lang} title={t.home.finalTitle} text={t.home.finalText} />
</BaseLayout>
