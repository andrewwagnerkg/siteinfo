---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import CtaSection from '../../../components/CtaSection.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Prose from '../../../components/Prose.astro';
import { useTranslations } from '../../../i18n';
import { entrySlug, entryStaticPaths, getLocalized } from '../../../lib/content';
import { href } from '../../../lib/paths';

export function getStaticPaths() {
  return entryStaticPaths('projects');
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]['props'];

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { data } = entry;
const { Content } = await render(entry);

const serviceTitles = new Map((await getLocalized('services', lang)).map((s) => [entrySlug(s), s.data.title]));
const services = data.services.map((slug) => ({ slug, title: serviceTitles.get(slug) ?? slug }));
const ogImage = data.cover ? (await getImage({ src: data.cover, width: 1200, format: 'jpg' })).src : undefined;
---

<BaseLayout lang={lang} title={data.title} description={data.summary} image={ogImage}>
  <PageHeader title={data.title} lead={data.summary}>
    <a slot="before" href={href(lang, 'portfolio')} class="link-quiet mb-4">
      <span aria-hidden="true">&larr;</span> {t.nav.portfolio}
    </a>
    <dl class="mt-10 grid gap-x-grid gap-y-6 border-t border-line pt-6 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt class="eyebrow">{t.portfolio.industry}</dt>
        <dd class="mt-1">{data.industry}</dd>
      </div>
      <div>
        <dt class="eyebrow">{t.portfolio.companySize}</dt>
        <dd class="mt-1">{data.company_size}</dd>
      </div>
      <div>
        <dt class="eyebrow">{t.portfolio.year}</dt>
        <dd class="mt-1">{data.year}</dd>
      </div>
      <div>
        <dt class="eyebrow">{t.portfolio.result}</dt>
        <dd class="mt-1"><strong>{data.headline_metric.value}</strong> {data.headline_metric.label}</dd>
      </div>
      {
        services.length > 0 && (
          <div class="sm:col-span-2 lg:col-span-4">
            <dt class="eyebrow">{t.portfolio.services}</dt>
            <dd class="mt-1">
              <ul role="list" class="flex flex-wrap gap-x-4">
                {services.map((s) => (
                  <li>
                    <a href={href(lang, `services/${s.slug}`)} class="link inline-flex min-h-touch items-center">
                      {s.title}
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>
  </PageHeader>

  {
    data.cover && (
      <Container class="mb-10">
        <Image
          src={data.cover}
          alt={data.cover_alt ?? ''}
          widths={[360, 720, 1080, 1440]}
          sizes="(min-width: 1280px) 1216px, 100vw"
          class="w-full rounded-panel border border-line"
          loading="eager"
        />
      </Container>
    )
  }

  <Container as="article">
    <Prose>
      <Content />
    </Prose>
    {
      data.quote && (
        <figure class="mt-12 max-w-measure border-l-4 border-fg pl-5 md:pl-8">
          <blockquote class="text-quote font-medium">
            <p>{data.quote.text}</p>
          </blockquote>
          <figcaption class="mt-4 text-muted">{data.quote.role}</figcaption>
        </figure>
      )
    }
  </Container>

  <CtaSection lang={lang} title={t.portfolio.ctaTitle} />
</BaseLayout>
