---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CardGrid from '../../../components/CardGrid.astro';
import Container from '../../../components/Container.astro';
import CtaSection from '../../../components/CtaSection.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import Prose from '../../../components/Prose.astro';
import Section from '../../../components/Section.astro';
import { useTranslations } from '../../../i18n';
import { byOrder, entrySlug, entryStaticPaths, getLocalized } from '../../../lib/content';
import { href } from '../../../lib/paths';

export function getStaticPaths() {
  return entryStaticPaths('services');
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]['props'];

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const slug = entrySlug(entry);

// Projects linked either from the service or from the project side.
const related = (await getLocalized('projects', lang))
  .filter((p) => entry.data.related_projects.includes(entrySlug(p)) || p.data.services.includes(slug))
  .sort(byOrder);
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.summary}>
  <PageHeader title={entry.data.title} lead={entry.data.summary}>
    <a slot="before" href={href(lang, 'services')} class="link-quiet mb-4">
      <span aria-hidden="true">&larr;</span> {t.nav.services}
    </a>
  </PageHeader>
  <Container>
    <Prose>
      <Content />
    </Prose>
  </Container>
  {
    related.length > 0 && (
      <Section id="related" title={t.services.relatedProjects}>
        <CardGrid>
          {related.map((p) => (
            <ProjectCard project={p} lang={lang} />
          ))}
        </CardGrid>
      </Section>
    )
  }
  <CtaSection lang={lang} title={t.home.finalTitle} text={t.home.finalText} />
</BaseLayout>
